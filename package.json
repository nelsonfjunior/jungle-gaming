  "version": "1.0.0",
  "description": "Distributed Wagering Processor for Jungle Gaming Technical Challenge",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
